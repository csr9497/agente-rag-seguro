# BACKEND_URL lo inyecta el entrypoint de nginx (envsubst) al arrancar.
# Token de Easy Auth → Authorization para el backend (vacío si no hay: el backend decide).
map $http_x_ms_token_aad_id_token $autorizacion_backend {
    ""      $http_authorization;
    default "Bearer $http_x_ms_token_aad_id_token";
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'" always;

    # Subida de documentos: hasta 1 MB por archivo (+ margen del multipart).
    location /api/documentos {
        proxy_pass ${BACKEND_URL}/documentos;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Usuario-Grupos "";
        # Easy Auth (Container Apps) inyecta el id token; el backend lo valida (firma incluida).
        proxy_set_header Authorization $autorizacion_backend;
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
        client_max_body_size 2m;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $proxy_host;
        # La identidad nunca la elige el cliente: se elimina la cabecera de depuración.
        proxy_set_header X-Usuario-Grupos "";
        # Easy Auth (Container Apps) inyecta el id token; el backend lo valida (firma incluida).
        proxy_set_header Authorization $autorizacion_backend;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        client_max_body_size 16k;
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }
}
