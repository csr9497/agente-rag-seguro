# Copia a .env (nunca se commitea). Guía: docs/modelos.md · Comprobar: make check-models

# Proveedor de modelos: azure (Azure OpenAI) | openai (OpenAI o endpoint compatible)
MODELOS_PROVEEDOR=azure

# --- MODELOS_PROVEEDOR=openai: clave directa, sin Azure CLI ni suscripción.
OPENAI_API_KEY=
# Vacío = OpenAI. Compatibles: https://openrouter.ai/api/v1, http://host.docker.internal:11434/v1 (Ollama)…
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# --- MODELOS_PROVEEDOR=azure: requiere suscripción activa y az login (o clave).
# Rellena con `make env-from-azure` tras desplegar la infra.
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
# Solo local. En Azure la app usa Managed Identity. Se lee de Key Vault (secreto azure-openai-api-key).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
# Dimensión del índice: debe coincidir con el modelo de embeddings (cambiarla obliga a reindexar).
EMBEDDING_DIMENSIONS=1536

VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
# Sin Docker: Qdrant embebido en disco (tiene prioridad sobre QDRANT_URL)
# QDRANT_PATH=.qdrant
QDRANT_COLLECTION=documentos

DATABASE_URL=sqlite:///data/app.db

RETRIEVAL_TOP_K=4
MAX_ITERACIONES=3
DEFAULT_USER=anonimo
DEFAULT_GROUPS=["public"]
# Solo local / pruebas de integración. Nunca en Azure.
IDENTIDAD_DEBUG=false

# Azure AI Content Safety (Prompt Shields), además de los guardrails locales. Vacío = solo locales.
# Sin clave usa DefaultAzureCredential (az login en local, Managed Identity en Azure).
CONTENT_SAFETY_ENDPOINT=
# Si el servicio falla: cerrado (bloquea/rechaza) | abierto (deja pasar y lo registra)
CONTENT_SAFETY_FALLO=cerrado

# Trazas en LangSmith: apagado | completo (solo dev) | enmascarado (prod)
ENTORNO=local
TRAZAS_MODO=apagado
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-rag-dev
# Prompts de sistema: local (app/prompts/*.md) | langsmith (la etiqueta PROMPTS_ETIQUETA de
# cada prompt; si no existe, el local). make prompts los publica (etiqueta dev).
PROMPTS_ORIGEN=local
PROMPTS_ETIQUETA=prod

# Despliegue en Azure (make deploy): OAuth App de GitHub para el login de la web.
# https://github.com/settings/applications/new · callback: la URL que imprime make deploy.
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
