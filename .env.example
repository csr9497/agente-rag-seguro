# Copia a .env (nunca se commitea). Rellena con `make env-from-azure` tras desplegar la infra.
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
# Solo local. En Azure la app usa Managed Identity. Se lee de Key Vault (secreto azure-openai-api-key).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
# Sin Docker: Qdrant embebido en disco (tiene prioridad sobre QDRANT_URL)
# QDRANT_PATH=.qdrant
QDRANT_COLLECTION=documentos

DATABASE_URL=sqlite:///data/app.db

RETRIEVAL_TOP_K=4
MAX_ITERACIONES=3
DEFAULT_USER=anonimo
DEFAULT_GROUPS=["public"]
# Solo local / pruebas de integración. Nunca en Azure.
IDENTIDAD_DEBUG=false

# Trazas en LangSmith: apagado | completo (solo dev) | enmascarado (prod)
ENTORNO=local
TRAZAS_MODO=apagado
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-rag-dev
